graph TB
    subgraph Client ["Presentation Layer"]
        ReactApp["React Web Dashboard\n(Vite + React + TS)"]
    end

    subgraph Ingress ["Edge Gateway"]
        Traefik["Traefik v3 Proxy\n(Port 80 / 8080)"]
    end

    subgraph Backend ["Application Tier (FastAPI)"]
        RouterLogs["Logs Router\n(/v1/logs)"]
        RouterIssues["Issues Router\n(/v1/issues)"]
        RateLimiter["@rate_limiter Decorator"]
        LogService["Log Service"]
        IssueService["Issue & Risk Service"]
        PDFGen["ReportLab PDF Generator"]
    end

    subgraph Infrastructure ["Storage & Cache Tier"]
        Redis["Redis (v8.6)\nCache & Limits"]
        Postgres["PostgreSQL (v16)\nSQLAlchemy 2.0 Async"]
    end

    ReactApp -->|HTTP Requests| Traefik
    Traefik -->|Host: api.localhost| RateLimiter
    RateLimiter -->|Check Limit| Redis
    RateLimiter --> RouterLogs
    RateLimiter --> RouterIssues
    RouterLogs --> LogService
    RouterIssues --> IssueService
    IssueService --> PDFGen
    LogService -->|Set/Get Cache| Redis
    LogService -->|Query/Insert| Postgres
    IssueService -->|Scan Telemetry| Postgres
