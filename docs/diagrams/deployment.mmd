graph TB
    subgraph HostMachine ["Host Machine (Docker Bridge Network: 'app')"]
        subgraph Ports ["Port Forwarding"]
            P80["Port :80 (HTTP)"]
            P8080["Port :8080 (Traefik Admin)"]
            P8000["Port :8000 (FastAPI API)"]
            P6379["Port :6379 (Redis)"]
            P5432["Port :5432 (Postgres)"]
        end

        subgraph Containers ["Docker Compose Services"]
            TraefikC["Traefik Gateway\n(traefik:v3.6.8)"]
            AppC["React App Container\n(Port 3000)"]
            ApiC["FastAPI API Container\n(Port 8000)"]
            RedisC["Redis Container\n(redis:8.6.0-alpine3.23)"]
            PostgresC["PostgreSQL Container\n(postgres:16-alpine)"]
        end

        subgraph Volumes ["Named Storage Volumes"]
            VolPostgres[("data-postgres")]
        end
    end

    P80 --> TraefikC
    P8080 --> TraefikC
    P8000 --> ApiC
    P6379 --> RedisC
    P5432 --> PostgresC

    TraefikC -->|Host: app.localhost| AppC
    TraefikC -->|Host: api.localhost| ApiC
    ApiC --> RedisC
    ApiC --> PostgresC
    PostgresC --- VolPostgres
